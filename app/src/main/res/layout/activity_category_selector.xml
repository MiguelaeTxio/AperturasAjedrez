<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/categoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/category_title"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/categoryLinesButton"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/categoryLinesButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/category_lines"
        app:layout_constraintTop_toBottomOf="@id/categoryTitle"
        app:layout_constraintBottom_toTopOf="@id/categoryEndgamesButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/categoryEndgamesButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/category_endgames"
        app:layout_constraintTop_toBottomOf="@id/categoryLinesButton"
        app:layout_constraintBottom_toTopOf="@id/categoryProblemsButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/categoryProblemsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/category_problems"
        app:layout_constraintTop_toBottomOf="@id/categoryEndgamesButton"
        app:layout_constraintBottom_toTopOf="@id/categoryTrampasButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/categoryTrampasButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/category_trampas"
        app:layout_constraintTop_toBottomOf="@id/categoryProblemsButton"
        app:layout_constraintBottom_toTopOf="@id/categoryEstructurasButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/categoryEstructurasButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/category_estructuras"
        app:layout_constraintTop_toBottomOf="@id/categoryTrampasButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
